# Copy to .env for local overrides. Never commit .env.
# Nothing here is secret yet; the first slice has no database or accounts.

# Where downloaded NOAA files and derived subsets are stored.
# Default when unset: <repository>/data (ignored by Git).
# MARINESCOPE_DATA_DIR=C:/path/to/marinescope-data

# Planned for MS-04 (PostgreSQL/PostGIS). Not read by any code yet.
# DATABASE_URL=postgresql+psycopg://marinescope:change-me@localhost:5432/marinescope
