# Copy to .env for local overrides. Never commit .env.
# Nothing here is secret yet: the database password is a local development default.

# Where downloaded NOAA files and derived subsets are stored.
# Default when unset: <repository>/data (ignored by Git).
# MARINESCOPE_DATA_DIR=C:/path/to/marinescope-data

# Database used by the API and by `alembic`. Default when unset (matches docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://marinescope:marinescope-local@127.0.0.1:5432/marinescope

# Host port for the database container, if 5432 is already in use on this machine.
# Change DATABASE_URL to match.
# MARINESCOPE_DB_PORT=5432

# Database the tests use. Default: database "marinescope_test" on the same server.
# TEST_DATABASE_URL=postgresql+psycopg://marinescope:marinescope-local@127.0.0.1:5432/marinescope_test
